<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WSecret Quick Access: packaged .NET 11 WinUI 3 shell.
    All secret material stays in the wsecret-broker process; this project
    handles metadata only and must never receive secret bytes over IPC.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>WSecret</RootNamespace>
    <AssemblyName>WSecret</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WSecret.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Program.cs owns the process entry point (single-instance activation);
         suppress the XAML compiler's generated Main. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Signing is driven by the packaging script (AppxPackageSigningEnabled +
         PackageCertificateThumbprint/-KeyFile). Publisher must stay CN=WSecret. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>

  <!--
    The broker executable produced by `cargo build -p wsecret-broker` is placed
    at the package root as wsecret-broker.exe and launched from
    Package.Current.InstalledLocation at runtime. Override WSecretBrokerExe to
    point at a specific cargo target directory.
  -->
  <PropertyGroup>
    <WSecretBrokerExe Condition="'$(WSecretBrokerExe)' == ''">$(MSBuildThisFileDirectory)..\..\target\release\wsecret-broker.exe</WSecretBrokerExe>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(WSecretBrokerExe)')">
    <Content Include="$(WSecretBrokerExe)" Link="wsecret-broker.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
